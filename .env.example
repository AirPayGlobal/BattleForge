# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║           BATTLEFORGE — Railway Environment Variables Reference             ║
# ║                                                                              ║
# ║  Set all of these in: Railway → your service → Variables                    ║
# ╚══════════════════════════════════════════════════════════════════════════════╝


# ── DATABASE ───────────────────────────────────────────────────────────────────
# Supabase Session mode pooler — works from any external IP.
# Get from: Supabase → Settings → Database → Connection string → Session mode
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"


# ── SUPABASE (server-side) ─────────────────────────────────────────────────────
# Project URL — Supabase → Settings → API → Project URL
SUPABASE_URL="https://your-project-ref.supabase.co"

# Service role key — Supabase → Settings → API → service_role
# ⚠  Never expose this to the browser or commit it to the repo.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."


# ── SUPABASE (client-side build args) ─────────────────────────────────────────
# These are baked into the React bundle at Docker build time via railway.toml.
# They are safe to expose — publishable/anon keys only.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."


# ── SERVER ─────────────────────────────────────────────────────────────────────
# The public URL of this Railway service — used for CORS and Stripe redirects.
# Set to your Railway-assigned domain once deployed.
CLIENT_URL="https://your-service.up.railway.app"

NODE_ENV="production"


# ── STRIPE (optional) ─────────────────────────────────────────────────────────
# Leave unset to use dev mode (payments are simulated without Stripe).
# sk_live_... / sk_test_... from dashboard.stripe.com
STRIPE_SECRET_KEY=""
# whsec_... from Stripe → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=""
