# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║            BATTLEFORGE — Environment Variable Reference                     ║
# ║                                                                              ║
# ║  Copy this file to:                                                          ║
# ║    server/.env       for the Node.js backend                                 ║
# ║    client/.env.local for the Vite frontend                                   ║
# ║                                                                              ║
# ║  Variables prefixed VITE_ are compiled into the client bundle at build time. ║
# ║  Never put secrets in VITE_ variables — they are publicly visible.           ║
# ╚══════════════════════════════════════════════════════════════════════════════╝


# ── DATABASE ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# • Local dev:    postgresql://postgres:password@localhost:5432/battleforge
# • Railway:      injected automatically when you add the PostgreSQL plugin —
#                 copy the value from the plugin's "Connect" tab.
# • Supabase:     use the "Direct connection" URI from Settings → Database.
DATABASE_URL="postgresql://user:password@localhost:5432/battleforge?schema=public"


# ── SUPABASE (Auth + PostgreSQL) ───────────────────────────────────────────────
# Create a free project at https://supabase.com → Settings → API.
#
# Project URL — visible in Settings → API → Project URL.
SUPABASE_URL="https://your-project-ref.supabase.co"

# Service Role Key — Settings → API → service_role key.
# ⚠  Keep this secret. It bypasses Row Level Security and has full DB access.
# ⚠  NEVER expose this in client-side code or commit it to version control.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── SUPABASE (client-side, safe to expose) ─────────────────────────────────────
# Publishable / anon key — Settings → API → anon / publishable key.
# This is safe to ship in the browser bundle (it enforces RLS policies).
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."


# ── SERVER ─────────────────────────────────────────────────────────────────────
# TCP port the Express server listens on locally.
# Railway overrides this with its own $PORT at runtime — you do not need to
# set PORT in Railway; set SERVER_PORT only for local Docker / local dev.
SERVER_PORT=3001

# Controls Express error verbosity and CORS policy.
# Set to "production" in all deployed environments.
NODE_ENV="development"

# The public URL of the deployed frontend.
# Used by the server for:
#   • CORS allow-list (Socket.io + Express)
#   • QR code URLs embedded in Certificate of Authenticity PDFs
# Example: "https://battleforge.vercel.app"
CLIENT_URL="http://localhost:5173"


# ── CLIENT (Vite — prefix all with VITE_) ─────────────────────────────────────
# Base URL of the REST API, consumed by the Axios instance in client/src/lib/api.ts.
# • Local dev (with Vite proxy):  leave empty or "http://localhost:3001/api"
# • Production:                   "https://your-railway-app.up.railway.app/api"
VITE_API_URL="http://localhost:3001/api"

# Base URL used to connect Socket.io (no path, just origin).
# Must point at the same host as VITE_API_URL without the /api suffix.
# • Local dev:   "http://localhost:3001"
# • Production:  "https://your-railway-app.up.railway.app"
VITE_WS_URL="http://localhost:3001"


# ── STRIPE ─────────────────────────────────────────────────────────────────────
# Leave ALL three Stripe variables unset (or empty) during local development.
# The server detects their absence and activates "dev mode":
#   • XP packs are credited instantly without a payment session.
#   • Battle Pass is granted instantly.
#   • Print orders are created with status QUEUED immediately.
#
# For testing real Stripe flows, use test-mode keys from dashboard.stripe.com.

# Server-side secret key — NEVER expose this to the browser.
# Test:  sk_test_...
# Live:  sk_live_...
STRIPE_SECRET_KEY=""

# Webhook signing secret — obtained from the Stripe dashboard after creating
# a webhook endpoint pointing to  https://your-domain/api/webhooks/stripe
# Test:  whsec_...
STRIPE_WEBHOOK_SECRET=""

# Client-side publishable key — safe to expose in the browser bundle.
# Test:  pk_test_...
# Live:  pk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=""


# ── RAILWAY DEPLOYMENT CHECKLIST ──────────────────────────────────────────────
# When setting up a new Railway service:
#
#  1. Add a PostgreSQL plugin to your project.
#     Railway injects DATABASE_URL automatically.
#
#  2. In your service → Variables, set:
#       SUPABASE_URL             = https://your-project-ref.supabase.co
#       SUPABASE_SERVICE_ROLE_KEY = eyJ... (from Supabase → Settings → API)
#       NODE_ENV                 = production
#       CLIENT_URL               = https://your-frontend.vercel.app
#
#  3. (Optional) Add Stripe variables for live payments:
#       STRIPE_SECRET_KEY        = sk_live_...
#       STRIPE_WEBHOOK_SECRET    = whsec_...
#
#  4. Run the initial migration via Railway's shell or on first deploy.
#     The Dockerfile CMD runs `npx prisma migrate deploy` automatically.
#
#  5. (Optional) Seed the database once:
#       railway run --service battleforge-api npm run seed
