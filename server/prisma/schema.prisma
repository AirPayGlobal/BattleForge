generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WeaponClass {
  BLADE
  POLEARM
  RANGED
  FORGE_ARTIFACT
  GAUNTLET
}

enum WeaponRank {
  IRON_I
  BRONZE_II
  STEEL_III
  OBSIDIAN_IV
  VOID_V
  INFERNO_VI
  ETERNAL_VII
}

enum DuelStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  DECLINED
  CANCELLED
}

enum TransactionType {
  XP_PACK_PURCHASE
  WEAPON_CRAFT
  DUEL_WIN
  DUEL_LOSS
  QUEST_REWARD
  DAILY_QUEST
  REFERRAL
  TOURNAMENT
  FORGE_SHIELD
  BATTLE_PASS
  GAUNTLET_WIN
  PRINT_ORDER
  CHARACTER_COSMETIC_PURCHASE
  NPC_BATTLE_WIN
}

enum CosmeticType {
  SKIN
  ACCESSORY
  MOD
}

enum NpcTier {
  BEGINNER
  WARRIOR
  ELITE
}

enum NpcBattleResult {
  WIN
  LOSS
}

enum TournamentStatus {
  UPCOMING
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RewardType {
  XP
  WEAPON_SKIN
  TITLE
  BADGE
  XP_BOOST
}

enum NotificationType {
  CHALLENGE_RECEIVED
  CHALLENGE_ACCEPTED
  CHALLENGE_DECLINED
  DUEL_WON
  DUEL_LOST
  WEAPON_WON
  WEAPON_LOST
  GAUNTLET_ISSUED
  GAUNTLET_EARNED
  QUEST_PROGRESS
  SYSTEM
}

model Player {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String    @unique
  xp            Int       @default(0)
  wins          Int       @default(0)
  losses        Int       @default(0)
  winStreak     Int       @default(0) @map("win_streak")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  characterId   String?   @map("character_id")
  character     Character? @relation(fields: [characterId], references: [id])

  weapons             Weapon[]
  challengesSent      Duel[]           @relation("Challenger")
  challengesReceived  Duel[]           @relation("Defender")
  duelsWon            Duel[]           @relation("Winner")
  transactions        Transaction[]
  notifications       Notification[]
  gauntletQuest       GauntletQuest?
  gauntlets           Gauntlet[]
  battlePasses        BattlePass[]
  tournamentEntries   TournamentEntry[]
  printOrders         PrintOrder[]
  printWaitlists      PrintWaitlist[]
  ownedCosmetics      PlayerCosmetic[]
  npcBattles          NpcBattle[]

  @@map("players")
}

model Weapon {
  id              String      @id @default(uuid())
  name            String
  class           WeaponClass
  rank            WeaponRank
  xpCost          Int         @map("xp_cost")
  wins            Int         @default(0)
  losses          Int         @default(0)
  isStaked        Boolean     @default(false) @map("is_staked")
  isPrintEligible Boolean     @default(false) @map("is_print_eligible")
  printMinted     Boolean     @default(false) @map("print_minted")
  mintSerialNumber String?    @unique @map("mint_serial_number")
  mintedAt        DateTime?   @map("minted_at")
  mintXpPaid      Int?        @map("mint_xp_paid")
  serialNumber    String      @unique @map("serial_number")
  forgeShield     Boolean     @default(false) @map("forge_shield")
  forgeShieldExp  DateTime?   @map("forge_shield_exp")
  createdAt       DateTime    @default(now()) @map("created_at")

  owner              Player           @relation(fields: [ownerId], references: [id])
  ownerId            String           @map("owner_id")

  challengerDuels    Duel[]           @relation("ChallengerWeapon")
  defenderDuels      Duel[]           @relation("DefenderWeapon")
  tournamentEntries  TournamentEntry[]
  printOrders        PrintOrder[]
  npcBattles         NpcBattle[]

  @@map("weapons")
}

model Duel {
  id                  String     @id @default(uuid())
  status              DuelStatus @default(PENDING)
  gauntletUsed        Boolean    @default(false) @map("gauntlet_used")
  rounds              Json?
  winnerId            String?    @map("winner_id")
  createdAt           DateTime   @default(now()) @map("created_at")
  completedAt         DateTime?  @map("completed_at")

  challenger          Player     @relation("Challenger", fields: [challengerId], references: [id])
  challengerId        String     @map("challenger_id")

  defender            Player     @relation("Defender", fields: [defenderId], references: [id])
  defenderId          String     @map("defender_id")

  winner              Player?    @relation("Winner", fields: [winnerId], references: [id])

  challengerWeapon    Weapon     @relation("ChallengerWeapon", fields: [challengerWeaponId], references: [id])
  challengerWeaponId  String     @map("challenger_weapon_id")

  defenderWeapon      Weapon     @relation("DefenderWeapon", fields: [defenderWeaponId], references: [id])
  defenderWeaponId    String     @map("defender_weapon_id")

  @@map("duels")
}

model GauntletQuest {
  id           String    @id @default(uuid())
  currentStage Int       @default(1) @map("current_stage")
  stageData    Json      @default("{}") @map("stage_data")
  completedAt  DateTime? @map("completed_at")

  player       Player    @relation(fields: [playerId], references: [id])
  playerId     String    @unique @map("player_id")

  @@map("gauntlet_quests")
}

model Transaction {
  id              String          @id @default(uuid())
  type            TransactionType
  xpAmount        Int             @map("xp_amount")
  usdAmount       Float?          @map("usd_amount")
  stripePaymentId String?         @map("stripe_payment_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  player          Player          @relation(fields: [playerId], references: [id])
  playerId        String          @map("player_id")

  @@map("transactions")
}

// ─── Phase 2 models ─────────────────────────────────────────────────────────

model Gauntlet {
  id            String    @id @default(uuid())
  serialNumber  String    @unique @map("serial_number")
  questEarned   Boolean   @default(false) @map("quest_earned")
  cooldownUntil DateTime? @map("cooldown_until")
  tempToken     Boolean   @default(false) @map("temp_token")
  tempExpiry    DateTime? @map("temp_expiry")
  createdAt     DateTime  @default(now()) @map("created_at")

  owner         Player    @relation(fields: [ownerId], references: [id])
  ownerId       String    @map("owner_id")

  @@map("gauntlets")
}

model Season {
  id            String    @id @default(uuid())
  name          String
  startDate     DateTime  @map("start_date")
  endDate       DateTime  @map("end_date")
  questChainName String   @map("quest_chain_name")
  active        Boolean   @default(false)

  tiers         BattlePassTier[]
  passes        BattlePass[]
  printRunLimits PrintRunLimit[]

  @@map("seasons")
}

model BattlePassTier {
  id          String     @id @default(uuid())
  tier        Int
  rewardType  RewardType @map("reward_type")
  rewardData  Json       @map("reward_data")
  xpRequired  Int        @map("xp_required")
  isPaid      Boolean    @default(false) @map("is_paid")

  season      Season     @relation(fields: [seasonId], references: [id])
  seasonId    String     @map("season_id")

  @@map("battle_pass_tiers")
}

model BattlePass {
  id          String   @id @default(uuid())
  purchasedAt DateTime @default(now()) @map("purchased_at")
  currentTier Int      @default(0) @map("current_tier")
  xpEarned    Int      @default(0) @map("xp_earned")

  player      Player   @relation(fields: [playerId], references: [id])
  playerId    String   @map("player_id")

  season      Season   @relation(fields: [seasonId], references: [id])
  seasonId    String   @map("season_id")

  @@unique([playerId, seasonId])
  @@map("battle_passes")
}

model Tournament {
  id              String            @id @default(uuid())
  name            String
  entryWeaponRank String            @map("entry_weapon_rank")
  startTime       DateTime          @map("start_time")
  status          TournamentStatus  @default(UPCOMING)
  maxPlayers      Int               @default(8) @map("max_players")
  prizePoolData   Json?             @map("prize_pool_data")
  bracket         Json?
  createdAt       DateTime          @default(now()) @map("created_at")

  entries         TournamentEntry[]

  @@map("tournaments")
}

model TournamentEntry {
  id           String     @id @default(uuid())
  enteredAt    DateTime   @default(now()) @map("entered_at")
  eliminated   Boolean    @default(false)
  placement    Int?

  player       Player     @relation(fields: [playerId], references: [id])
  playerId     String     @map("player_id")

  weapon       Weapon     @relation(fields: [weaponId], references: [id])
  weaponId     String     @map("weapon_id")

  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId String     @map("tournament_id")

  @@unique([playerId, tournamentId])
  @@map("tournament_entries")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now()) @map("created_at")

  player    Player           @relation(fields: [playerId], references: [id])
  playerId  String           @map("player_id")

  @@map("notifications")
}

// ─── Phase 2.5 — Physical Print Mint Layer ──────────────────────────────────

enum PrintOrderStatus {
  QUEUED
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
}

model PrintOrder {
  id              String           @id @default(uuid())
  status          PrintOrderStatus @default(QUEUED)
  fulfillmentRef  String?          @map("fulfillment_ref")
  shippingAddress Json             @map("shipping_address")
  priceUsd        Float            @map("price_usd")
  stripePaymentId String?          @map("stripe_payment_id")
  trackingLink    String?          @map("tracking_link")
  mintSerial      String?          @map("mint_serial")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  player          Player           @relation(fields: [playerId], references: [id])
  playerId        String           @map("player_id")

  weapon          Weapon           @relation(fields: [weaponId], references: [id])
  weaponId        String           @map("weapon_id")

  @@map("print_orders")
}

model PrintRunLimit {
  id           String   @id @default(uuid())
  rank         String
  seasonId     String?  @map("season_id")
  maxPrints    Int      @map("max_prints")
  currentCount Int      @default(0) @map("current_count")
  season       Season?  @relation(fields: [seasonId], references: [id])

  @@unique([rank, seasonId])
  @@map("print_run_limits")
}

model PrintWaitlist {
  id         String   @id @default(uuid())
  rank       String
  seasonId   String?  @map("season_id")
  joinedAt   DateTime @default(now()) @map("joined_at")
  notified   Boolean  @default(false)

  player     Player   @relation(fields: [playerId], references: [id])
  playerId   String   @map("player_id")

  @@unique([playerId, rank, seasonId])
  @@map("print_waitlists")
}

// ─── Phase 3 — Character System ─────────────────────────────────────────────

model Character {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  imageUrl    String?  @map("image_url")
  isDefault   Boolean  @default(false) @map("is_default")

  players     Player[]
  npcs        Npc[]
  cosmetics   CharacterCosmetic[]

  @@map("characters")
}

model CharacterCosmetic {
  id          String       @id @default(uuid())
  name        String
  type        CosmeticType
  description String
  imageUrl    String?      @map("image_url")
  xpPrice     Int?         @map("xp_price")
  usdPrice    Float?       @map("usd_price")
  characterId String?      @map("character_id")

  character   Character?   @relation(fields: [characterId], references: [id])
  ownedBy     PlayerCosmetic[]

  @@map("character_cosmetics")
}

model PlayerCosmetic {
  id           String        @id @default(uuid())
  equippedSlot CosmeticType? @map("equipped_slot")
  acquiredAt   DateTime      @default(now()) @map("acquired_at")

  player       Player        @relation(fields: [playerId], references: [id])
  playerId     String        @map("player_id")

  cosmetic     CharacterCosmetic @relation(fields: [cosmeticId], references: [id])
  cosmeticId   String        @map("cosmetic_id")

  @@unique([playerId, cosmeticId])
  @@map("player_cosmetics")
}

model Npc {
  id          String   @id @default(uuid())
  name        String   @unique
  tier        NpcTier
  description String
  imageUrl    String?  @map("image_url")
  characterId String   @map("character_id")

  character   Character @relation(fields: [characterId], references: [id])
  battles     NpcBattle[]

  @@map("npcs")
}

model NpcBattle {
  id          String          @id @default(uuid())
  result      NpcBattleResult
  xpEarned    Int             @map("xp_earned")
  rounds      Json?
  completedAt DateTime        @default(now()) @map("completed_at")

  player      Player          @relation(fields: [playerId], references: [id])
  playerId    String          @map("player_id")

  npc         Npc             @relation(fields: [npcId], references: [id])
  npcId       String          @map("npc_id")

  weapon      Weapon          @relation(fields: [weaponId], references: [id])
  weaponId    String          @map("weapon_id")

  @@map("npc_battles")
}
